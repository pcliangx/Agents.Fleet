{
  "name": "agents-fleet",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.33.2",
  "engines": {
    "node": ">=20",
    "pnpm": ">=10"
  },
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": "22.17.1",
      "onFail": "download"
    }
  },
  "scripts": {
    "typecheck": "tsc -b",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e:handshake": "vitest run packages/daemon/src/__tests__/handshake-e2e.test.ts",
    "lint": "biome check .",
    "format": "biome format --write .",
    "prototype:r0-06": "pnpm --filter @agents-fleet/daemon exec tsx ../transport/src/prototypes/r0-06-binary-stream/tui.ts",
    "prototype:r0-06:benchmark": "pnpm --filter @agents-fleet/daemon exec tsx ../transport/src/prototypes/r0-06-binary-stream/benchmark.ts --duration 60",
    "dev:daemon": "pnpm --filter @agents-fleet/daemon dev",
    "dev:desktop": "pnpm --filter @agents-fleet/desktop dev"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.0.0",
    "@types/node": "^22.0.0",
    "typescript": "~5.7.0",
    "vitest": "^3.0.0"
  }
}
